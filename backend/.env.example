# GOOGLE_GEOCODING_KEY: Google Geocoding API key, used by geocoding.py
# to resolve place names to coordinates (search is restricted to Colorado).
GOOGLE_GEOCODING_KEY=

# GOOGLE_DIRECTIONS_KEY: Google Directions API key, used by directions.py for
# exact drive-time/route detailing. Separate from GOOGLE_GEOCODING_KEY on
# purpose — verified the geocoding key is NOT authorized for Directions
# (REQUEST_DENIED), so this needs the Directions API enabled in its own
# Google Cloud Console project/key restrictions.
GOOGLE_DIRECTIONS_KEY=

# GEMINI_API_KEY: Gemini API key (Google AI Studio, not Cloud Console), used by
# enrichment.py to enrich a route with gemini-2.0-flash + Google Search
# grounding. Separate key type from the two above — issued at
# https://aistudio.google.com/apikey, not tied to the Directions/Geocoding
# Cloud Console project.
GEMINI_API_KEY=

# DATABASE_URL: PostGIS connection string. Single shared pool in db.py — poi.py
# queries public.attractions with it, sessions.py queries app.anonymous_sessions.
DATABASE_URL=postgresql://user:password@localhost:5433/road-trip-planner

# SESSION_SECRET: HMAC key sessions.py signs the "rtp_session" cookie with.
# Generate with e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Rotating it invalidates every existing session (their cookie's signature no
# longer verifies) — everyone gets a fresh anonymous session, not an error.
SESSION_SECRET=

# COOKIE_SECURE: "true" in production (https). Leave "false" (or unset) for
# local http development — a Secure cookie is silently dropped by the browser
# over plain http, which looks like sessions not persisting at all.
COOKIE_SECURE=false

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID (Google Cloud Console, "Web
# application" type) used by auth.py to verify Google ID tokens — MUST match
# the "aud" claim google-auth checks in verify_google_token, and is also the
# client ID the frontend's Google Identity Services button is configured
# with. A mismatch here fails every login with a generic 401, not a helpful
# error, since verify_oauth2_token doesn't say which check failed.
GOOGLE_CLIENT_ID=
